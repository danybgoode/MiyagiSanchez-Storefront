    "mercadopago": "^3.0.0",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "sharp": "^0.35.3",
    "stripe": "^22.1.1",
    "undici": "^8.8.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
